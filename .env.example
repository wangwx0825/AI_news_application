# Supabase 配置（请替换为你自己的 Supabase 项目值）
# 获取方式：https://supabase.com/ -> 创建项目 -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vercel Cron 和受保护导入接口鉴权
# 生产环境必须配置。建议使用至少 16 位的随机字符串。
CRON_SECRET=your-random-cron-secret-here

# 站点地址
# 本地开发: http://localhost:3000
# 线上部署后: https://your-domain.vercel.app 或自定义域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000
